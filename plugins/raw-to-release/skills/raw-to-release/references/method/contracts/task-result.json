{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw-to-release.dev/contracts/2/task-result.json",
  "type": "object",
  "required": ["contract_version", "status", "summary", "evidence", "artifacts_or_changed_files", "verification", "risks_or_unknowns", "recommended_next_route"],
  "properties": {
    "contract_version": {"$ref": "common.json#/$defs/contract_version"},
    "status": {"enum": ["complete", "partial", "blocked"]},
    "summary": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "evidence-ref.json"}},
    "artifacts_or_changed_files": {"type": "array", "items": {"type": "string"}},
    "verification": {"type": "string", "minLength": 1},
    "risks_or_unknowns": {"type": "array", "items": {"type": "string"}},
    "recommended_next_route": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
