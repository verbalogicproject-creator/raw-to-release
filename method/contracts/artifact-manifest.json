{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw-to-release.dev/contracts/2/artifact-manifest.json",
  "type": "object",
  "required": ["contract_version", "run_id", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"$ref": "common.json#/$defs/contract_version"},
    "run_id": {"$ref": "common.json#/$defs/run_id"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256", "git_blob_id", "owning_commit", "file_type"], "additionalProperties": false, "properties": {
      "path": {"$ref": "common.json#/$defs/safe_path"},
      "sha256": {"$ref": "common.json#/$defs/sha256"},
      "git_blob_id": {"$ref": "common.json#/$defs/git_sha"},
      "owning_commit": {"$ref": "common.json#/$defs/git_sha"},
      "file_type": {"const": "regular"}
    }}}
  }
}
