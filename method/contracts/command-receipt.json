{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw-to-release.dev/contracts/2/command-receipt.json",
  "type": "object",
  "required": ["contract_version", "receipt_type", "receipt_id", "run_id", "task_id", "command_id", "argv", "cwd", "implementation_sha", "started_at", "ended_at", "exit_code", "outcome", "test_counts", "stdout_sha256", "stderr_sha256", "failure_excerpt"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"$ref": "common.json#/$defs/contract_version"},
    "receipt_type": {"const": "command"},
    "receipt_id": {"$ref": "common.json#/$defs/identifier"},
    "run_id": {"$ref": "common.json#/$defs/run_id"},
    "task_id": {"$ref": "common.json#/$defs/identifier"},
    "command_id": {"$ref": "common.json#/$defs/identifier"},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "cwd": {"$ref": "common.json#/$defs/safe_path"},
    "implementation_sha": {"$ref": "common.json#/$defs/git_sha"},
    "started_at": {"$ref": "common.json#/$defs/timestamp"},
    "ended_at": {"$ref": "common.json#/$defs/timestamp"},
    "exit_code": {"type": "integer", "minimum": 0},
    "outcome": {"enum": ["pass", "fail"]},
    "test_counts": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["passed", "failed"], "additionalProperties": false, "properties": {"passed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}}}]},
    "stdout_sha256": {"$ref": "common.json#/$defs/sha256"},
    "stderr_sha256": {"$ref": "common.json#/$defs/sha256"},
    "failure_excerpt": {"type": "string", "maxLength": 2048}
  }
}
