{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw-to-release.dev/contracts/2/run-observation.json",
  "type": "object",
  "required": ["contract_version", "run_id", "requested_route", "observed_route", "requested_model", "observed_model", "fallbacks", "approvals", "result", "acceptance_outcome", "transcript_recorded", "sensitive_content_recorded"],
  "properties": {
    "contract_version": {"$ref": "common.json#/$defs/contract_version"},
    "run_id": {"$ref": "common.json#/$defs/run_id"},
    "requested_route": {"type": "string", "minLength": 1},
    "observed_route": {"type": ["string", "null"]},
    "requested_model": {"type": ["string", "null"]},
    "observed_model": {"type": ["string", "null"]},
    "fallbacks": {"type": "array", "items": {"type": "string"}},
    "approvals": {"type": "array", "items": {"type": "string"}},
    "result": {"enum": ["complete", "partial", "blocked"]},
    "acceptance_outcome": {"enum": ["pass", "fail", "unknown"]},
    "transcript_recorded": {"const": false},
    "sensitive_content_recorded": {"const": false}
  },
  "additionalProperties": false
}
