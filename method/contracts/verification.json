{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw-to-release.dev/contracts/2/verification.json",
  "type": "object",
  "required": ["contract_version", "run_id", "implementation_sha", "command_receipts", "review_receipt", "outcome"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"$ref": "common.json#/$defs/contract_version"},
    "run_id": {"$ref": "common.json#/$defs/run_id"},
    "implementation_sha": {"$ref": "common.json#/$defs/git_sha"},
    "command_receipts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.json#/$defs/safe_path"}},
    "review_receipt": {"$ref": "common.json#/$defs/safe_path"},
    "outcome": {"enum": ["pass", "fail"]}
  }
}
